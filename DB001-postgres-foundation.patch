+/**
+ * DB-001: Compares production SQLite CRM with PostgreSQL dry-run target.
+ * Exit code 1 on any mismatch. No writes are performed.
+ */
+const { PrismaClient: SourceClient } = require("@prisma/client-crm");
+const { PrismaClient: TargetClient } = require("@prisma/client-crm-pg");
+
+const source = new SourceClient();
+const target = new TargetClient();
+const MONEY_TOLERANCE = 0.01;
+
+async function snapshot(db) {
+  const [
+    totalLeads,
+    qualifiedCount,
+    checkinCount,
+    purchaseCount,
+    totals,
+    historyCount,
+  ] = await Promise.all([
+    db.cRMLead.count(),
+    db.cRMLead.count({ where: { status: { in: ["QUALIFIED", "SCHEDULED"] } } }),
+    db.cRMLead.count({
+      where: {
+        OR: [
+          { status: "CHECKIN" },
+          { status: "PURCHASE" },
+          { checkinDate: { not: null } },
+        ],
+      },
+    }),
+    db.cRMLead.count({ where: { status: "PURCHASE" } }),
+    db.cRMLead.aggregate({
+      _sum: { revenue: true, actualRevenue: true, caTheoRevenue: true },
+    }),
+    db.cRMStatusHistory.count(),
+  ]);
+
+  return {
+    totalLeads,
+    qualifiedCount,
+    checkinCount,
+    purchaseCount,
+    revenue: totals._sum.revenue || 0,
+    actualRevenue: totals._sum.actualRevenue || 0,
+    caTheoRevenue: totals._sum.caTheoRevenue || 0,
+    historyCount,
+  };
+}
+
+function sameMoney(a, b) {
+  return Math.abs(Number(a) - Number(b)) <= MONEY_TOLERANCE;
+}
+
+async function main() {
+  if (!process.env.CRM_POSTGRES_URL) {
+    throw new Error("CRM_POSTGRES_URL is required for verification.");
+  }
+  await source.$connect();
+  await target.$connect();
+
+  const [sqlite, postgres] = await Promise.all([snapshot(source), snapshot(target)]);
+  const checks = [
+    ["Total leads", sqlite.totalLeads, postgres.totalLeads, (a,b) => a === b],
+    ["Qualified", sqlite.qualifiedCount, postgres.qualifiedCount, (a,b) => a === b],
+    ["Check-in", sqlite.checkinCount, postgres.checkinCount, (a,b) => a === b],
+    ["Purchase", sqlite.purchaseCount, postgres.purchaseCount, (a,b) => a === b],
+    ["Revenue", sqlite.revenue, postgres.revenue, sameMoney],
+    ["Actual revenue", sqlite.actualRevenue, postgres.actualRevenue, sameMoney],
+    ["Ca theo revenue", sqlite.caTheoRevenue, postgres.caTheoRevenue, sameMoney],
+    ["Status history", sqlite.historyCount, postgres.historyCount, (a,b) => a === b],
+  ];
+
+  console.log("\\nCRM MIGRATION VERIFY");
+  console.log("=".repeat(72));
+  let failed = 0;
+  for (const [label, a, b, compare] of checks) {
+    const ok = compare(a, b);
+    if (!ok) failed++;
+    console.log(`${ok ? "PASS" : "FAIL"} | ${label.padEnd(20)} | SQLite=${a} | Postgres=${b}`);
+  }
+  console.log("=".repeat(72));
+  console.log(failed === 0 ? "STATUS: PASS - eligible for later cutover review (NOT automatic)." : `STATUS: FAIL - ${failed} mismatches. DO NOT CUT OVER.`);
+  if (failed) process.exitCode = 1;
+}
+
+main()
+  .catch((err) => {
+    console.error("[DB-001] VERIFY FAILED:", err.message);
+    process.exitCode = 1;
+  })
+  .finally(async () => {
+    await Promise.allSettled([source.$disconnect(), target.$disconnect()]);
+  });

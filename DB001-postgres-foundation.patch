+/**
+ * DB-001: Idempotent SQLite -> PostgreSQL CRM migration.
+ * This script DOES NOT switch the running application datasource.
+ * Prerequisites:
+ *   npm run prisma:generate
+ *   npm run prisma:generate:postgres
+ *   npm run db:postgres:push
+ *   CRM_POSTGRES_URL must point at the PostgreSQL crm schema.
+ */
+const { PrismaClient: SourceClient } = require("@prisma/client-crm");
+const { PrismaClient: TargetClient } = require("@prisma/client-crm-pg");
+
+const source = new SourceClient();
+const target = new TargetClient();
+const BATCH_SIZE = Math.max(50, Math.min(2000, Number(process.env.CRM_MIGRATION_BATCH_SIZE || 500)));
+
+function leadData(row) {
+  return {
+    id: row.id,
+    leadId: row.leadId,
+    fullName: row.fullName,
+    phone: row.phone,
+    email: row.email,
+    phoneHash: row.phoneHash,
+    emailHash: row.emailHash,
+    source: row.source,
+    sourceGroup: row.sourceGroup,
+    status: row.status,
+    telesale: row.telesale,
+    branch: row.branch,
+    branchGroup: row.branchGroup,
+    service: row.service,
+    serviceGroup: row.serviceGroup,
+    checkinDate: row.checkinDate,
+    isMonthNote: row.isMonthNote,
+    result: row.result,
+    isOldCustomer: row.isOldCustomer,
+    isKoMkt: row.isKoMkt,
+    isVietKieu: row.isVietKieu,
+    isNN: row.isNN,
+    revenue: row.revenue,
+    actualRevenue: row.actualRevenue,
+    caTheoRevenue: row.caTheoRevenue,
+    fbclid: row.fbclid,
+    fbp: row.fbp,
+    fbc: row.fbc,
+    note: row.note,
+    value: row.value,
+    currency: row.currency,
+    syncedToMeta: row.syncedToMeta,
+    metaEventResponse: row.metaEventResponse,
+    ref: row.ref,
+    createdAt: row.createdAt,
+    updatedAt: row.updatedAt,
+  };
+}
+
+function historyData(row) {
+  return {
+    id: row.id,
+    leadId: row.leadId,
+    previousStatus: row.previousStatus,
+    newStatus: row.newStatus,
+    updatedBy: row.updatedBy,
+    createdAt: row.createdAt,
+  };
+}
+
+async function migrateModel({ name, sourceModel, targetModel, map }) {
+  const total = await sourceModel.count();
+  console.log(`[DB-001] ${name}: source=${total}, batch=${BATCH_SIZE}`);
+  let cursor;
+  let processed = 0;
+
+  while (true) {
+    const rows = await sourceModel.findMany({
+      orderBy: { id: "asc" },
+      take: BATCH_SIZE,
+      ...(cursor ? { cursor: { id: cursor }, skip: 1 } : {}),
+    });
+    if (!rows.length) break;
+
+    await target.$transaction(
+      rows.map((row) => {
+        const data = map(row);
+        return targetModel.upsert({
+          where: { id: row.id },
+          create: data,
+          update: data,
+        });
+      })
+    );
+
+    processed += rows.length;
+    cursor = rows[rows.length - 1].id;
+    console.log(`[DB-001] ${name}: ${processed}/${total}`);
+  }
+}
+
+async function main() {
+  if (!process.env.CRM_POSTGRES_URL) {
+    throw new Error("CRM_POSTGRES_URL is required. Migration aborted before any target write.");
+  }
+
+  await source.$connect();
+  await target.$connect();
+
+  // Parent rows first, relation history second.
+  await migrateModel({
+    name: "CRMLead",
+    sourceModel: source.cRMLead,
+    targetModel: target.cRMLead,
+    map: leadData,
+  });
+
+  await migrateModel({
+    name: "CRMStatusHistory",
+    sourceModel: source.cRMStatusHistory,
+    targetModel: target.cRMStatusHistory,
+    map: historyData,
+  });
+
+  console.log("[DB-001] Migration finished. Application is still using SQLite; run verification next.");
+}
+
+main()
+  .catch((err) => {
+    console.error("[DB-001] MIGRATION FAILED:", err.message);
+    process.exitCode = 1;
+  })
+  .finally(async () => {
+    await Promise.allSettled([source.$disconnect(), target.$disconnect()]);
+  });

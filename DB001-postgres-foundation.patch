+datasource db {
+  provider = "postgresql"
+  url      = env("CRM_POSTGRES_URL")
+}
+
+generator client {
+  provider = "prisma-client-js"
+  output   = "../node_modules/@prisma/client-crm-pg"
+}
+
+model CRMLead {
+  id                String             @id @default(cuid())
+  leadId            String?
+  fullName          String
+  phone             String
+  email             String?
+  phoneHash         String
+  emailHash         String?
+  source            String             @default("META_INSTANT_FORM")
+  sourceGroup       String             @default("KHÁC")
+  status            String             @default("NEW")
+  telesale          String?
+  branch            String?
+  branchGroup       String?
+  service           String?
+  serviceGroup      String?
+  checkinDate       String?
+  isMonthNote       Boolean            @default(false)
+  result            String?
+  isOldCustomer     Boolean            @default(false)
+  isKoMkt           Boolean            @default(false)
+  isVietKieu        Boolean            @default(false)
+  isNN              Boolean            @default(false)
+  revenue           Float              @default(0)
+  actualRevenue     Float              @default(0)
+  caTheoRevenue     Float              @default(0)
+  fbclid            String?
+  fbp               String?
+  fbc               String?
+  note              String?
+  value             Float?
+  currency          String             @default("VND")
+  syncedToMeta      Boolean            @default(false)
+  metaEventResponse String?
+  ref               String?
+  createdAt         DateTime           @default(now())
+  updatedAt         DateTime           @updatedAt
+  statusHistory     CRMStatusHistory[]
+
+  @@index([phone])
+  @@index([status])
+  @@index([createdAt])
+  @@index([sourceGroup])
+  @@index([telesale])
+  @@index([branchGroup])
+  @@index([serviceGroup])
+  @@index([checkinDate])
+}
+
+model CRMStatusHistory {
+  id             String   @id @default(cuid())
+  leadId         String
+  lead           CRMLead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
+  previousStatus String
+  newStatus      String
+  updatedBy      String   @default("SYSTEM")
+  createdAt      DateTime @default(now())
+
+  @@index([leadId])
+  @@index([createdAt])
+}

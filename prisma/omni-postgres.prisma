datasource db {
  provider = "postgresql"
  url      = env("OMNI_POSTGRES_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client-omni-pg"
}

// 1. Quản lý Danh sách 60 Fanpages (PostgreSQL Foundation)
model OmniFanpage {
  id            String   @id @default(cuid())
  pageId        String   @unique
  pageName      String
  accessToken   String?
  category      String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  conversations OmniConversation[]
}

// 2. Quản lý Thẻ Pancake.vn
model OmniPancakeTag {
  id          String   @id @default(cuid())
  tagId       String   @unique
  tagName     String
  colorHex    String?
  category    String?
  createdAt   DateTime @default(now())
}

// 3. Quản lý Hội thoại Đa Kênh
model OmniConversation {
  id                String   @id @default(cuid())
  pageId            String
  fanpage           OmniFanpage @relation(fields: [pageId], references: [pageId], onDelete: Cascade)

  psid              String
  igsid             String?
  customerName      String?
  phone             String?
  pancakeCustomerId String?
  tags              String?  // JSON Array

  // AI Extracted Intelligence
  detectedBranch    String?
  branchStatus      String?
  detectedService   String?
  subService        String?
  quotedBudget      Float?
  customerIntent    String?
  aiConfidence      Float    @default(0)
  aiAnalyzedAt      DateTime?

  lastMessageAt     DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  messages          OmniMessage[]

  @@index([psid])
  @@index([pageId])
  @@index([phone])
  @@index([detectedBranch])
  @@index([detectedService])
  @@index([customerIntent])
}

// 4. Lịch sử Tin nhắn chi tiết
model OmniMessage {
  id              String           @id @default(cuid())
  conversationId String
  conversation   OmniConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderType      String           // "CUSTOMER", "STAFF", "AI_BOT"
  senderId        String?
  text            String
  mid             String?

  createdAt       DateTime         @default(now())

  @@index([conversationId])
  @@index([senderType])
  @@index([createdAt])
}

// AI Reply Suggestion Log � persist d? h?c pattern
model OmniAILog {
  id             String   @id @default(cuid())
  conversationId String
  promptText     String   // Tin nh?n g?c c?a kh�ch
  suggestion     String   // G?i � c?a AI
  wasUsed        Boolean  @default(false)
  wasEdited      Boolean  @default(false)
  finalText      String?  // Text th?c s? du?c g?i
  model          String?  // Gemini/OpenAI model used
  latencyMs      Int?
  createdAt      DateTime @default(now())

  @@index([conversationId])
  @@index([createdAt])
}

// Rule t? d?ng g?n th? / ph�n branch
model OmniAutoRule {
  id          String   @id @default(cuid())
  name        String
  condition   String   // JSON: {field, operator, value}
  action      String   // JSON: {type, value} � type: TAG | BRANCH | ASSIGN
  priority    Int      @default(0)
  isActive    Boolean  @default(true)
  triggerCount Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// L?ch s? d?ng b? sang CRM
model OmniCRMSync {
  id             String   @id @default(cuid())
  conversationId String?
  psid           String?
  phone          String?
  crmLeadId      String?
  status         String   @default("SYNCED") // SYNCED | FAILED | SKIPPED
  errorMsg       String?
  syncedAt       DateTime @default(now())

  @@index([conversationId])
  @@index([phone])
  @@index([status])
}

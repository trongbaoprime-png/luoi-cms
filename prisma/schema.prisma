// ==============================================================================
// ⚠️ ARCHITECTURE NOTICE — MODULAR 5-DATABASE SYSTEM
// ==============================================================================
// Do not edit this file directly. This project uses 5 isolated database schemas:
// 1. prisma/cms.prisma          -> luoi_core / CORE_DATABASE_URL    (@prisma/client-cms)
// 2. prisma/meta-ads.prisma     -> luoi_meta / META_ADS_DATABASE_URL (@prisma/client-meta)
// 3. prisma/crm-postgres.prisma -> luoi_crm  / CRM_POSTGRES_URL      (@prisma/client-crm-pg)
// 4. prisma/omni-postgres.prisma-> luoi_omni / OMNI_POSTGRES_URL     (@prisma/client-omni-pg)
// 5. prisma/tracking.prisma     -> luoi_tracking / TRACKING_DATABASE_URL (@prisma/client-tracking)
//
// Each database has its own isolated connection, lifecycle, and client.
// ==============================================================================

datasource db {
  provider = "postgresql"
  url      = env("CORE_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

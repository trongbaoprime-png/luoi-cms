datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  password    String   // Hashed password
  role        String   @default("EDITOR") // ADMIN, EDITOR, AUTHOR
  permissions String?  // JSON string containing granular permissions list
  avatar      String?
  bio         String?
  status      String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  posts       Post[]
}

model Post {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  summary         String?
  content         String
  coverImage      String?
  status          String    @default("PUBLISHED")
  isFeatured      Boolean   @default(false)
  views           Int       @default(0)
  readTimeMinutes Int       @default(5)
  seoTitle        String?
  seoDescription  String?
  schemaJson      String?
  userId          String?
  user            User?     @relation(fields: [userId], references: [id])
  authorId        String?
  author          Author?   @relation(fields: [authorId], references: [id])
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  posts       Post[]
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Author {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  avatar    String?
  bio       String?
  posts     Post[]
  createdAt DateTime @default(now())
}

model Media {
  id        String   @id @default(cuid())
  filename  String
  url       String
  mimeType  String
  size      Int
  createdAt DateTime @default(now())
}

model Page {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  content        String?
  blocks         String?  // JSON string of UX Builder visual blocks array
  seoTitle       String?
  seoDescription String?
  isPublished    Boolean  @default(true)
  useDefaultHeader Boolean @default(true)
  useDefaultFooter Boolean @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   // Stores setting values (e.g. homepage_type, homepage_page_id, header_menu)
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String?
  action    String   // e.g. "ARTICLE_CREATE", "USER_UPDATE", "MEDIA_DELETE"
  entity    String   // "Article", "User", "Media", "Deal"
  details   String?  // JSON details of change
  ipAddress String?
  createdAt DateTime @default(now())
}

model Webhook {
  id        String   @id @default(cuid())
  name      String
  url       String
  events    String   // JSON list of events e.g. ["article.created", "deal.created"]
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
}

model AdsSetting {
  id          String   @id @default(cuid())
  platform    String   @unique
  pixelId     String?
  accessToken String?
  testCode    String?
  isEnabled   Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

model AdsLog {
  id        String   @id @default(cuid())
  platform  String
  eventName String
  eventData String
  status    String
  response  String?
  createdAt DateTime @default(now())
}

model AISetting {
  id           String   @id @default(cuid())
  provider     String   @default("GEMINI")
  apiKey       String?
  defaultModel String   @default("gemini-1.5-pro")
  updatedAt    DateTime @updatedAt
}

model Product {
  id             String     @id @default(cuid())
  name           String     @default("")
  title          String     @default("")
  slug           String     @unique
  description    String?
  price          Float?
  originalPrice  Float?
  image          String?
  rating         Float      @default(5.0)
  pros           String?    // JSON or line-separated pros
  cons           String?    // JSON or line-separated cons
  affiliateUrl   String
  merchant       String     @default("Shopee") // Shopee, Lazada, Tiki, etc.
  clicks         Int        @default(0)
  salesCount     Int        @default(0)
  isFeatured     Boolean    @default(false)
  seoTitle       String?
  seoDescription String?
  categoryId     String?
  category       Category?  @relation(fields: [categoryId], references: [id])
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  clickLogs      ClickLog[]
  deals          Deal[]
}

model Deal {
  id            String    @id @default(cuid())
  code          String
  title         String
  discount      String    // e.g. "Giảm 50k", "Freeship"
  merchant      String    // Shopee, Lazada, Tiki
  affiliateUrl  String
  discountPrice Float?
  originalPrice Float?
  startDate     DateTime?
  endDate       DateTime?
  expiresAt     DateTime?
  usageCount    Int       @default(0)
  isHot         Boolean   @default(false)
  isActive      Boolean   @default(true)
  productId     String?
  product       Product?  @relation(fields: [productId], references: [id])
  createdAt     DateTime  @default(now())
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
}

model ContactMessage {
  id              String   @id @default(cuid())
  name            String
  email           String
  subject         String?
  message         String
  ipAddress       String?
  status          String   @default("UNREAD")
  conversionStage String   @default("REGISTERED") // REGISTERED, QUALIFIED_LEAD, APPOINTMENT, PURCHASE
  gclid           String?
  wbraid          String?
  gbraid          String?
  fbclid          String?
  fbc             String?
  fbp             String?
  ttclid          String?
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  createdAt       DateTime @default(now())
}

model ClickLog {
  id        String   @id @default(cuid())
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  targetUrl String
  merchant  String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

model ShortcodeBlock {
  id         String   @id @default(cuid())
  name       String
  key        String   @unique
  type       String   // "PRICING", "FORM", "SLIDER", "OFFERS"
  configJson String   // Stores JSON configuration of custom columns, fields, banners, highlights
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model CRMLead {
  id                String             @id @default(cuid())
  leadId            String?            // ID từ Meta Ads (leadgen_id)
  fullName          String
  phone             String
  email             String?
  phoneHash         String             // SHA256 hashed phone
  emailHash         String?            // SHA256 hashed email
  source            String             @default("META_INSTANT_FORM") // META_INSTANT_FORM, WEBSITE_FORM, MESSENGER, ZALO
  sourceGroup       String             @default("KHÁC") // FACEBOOK, WEBSITE, TIKTOK, HOTLINE, KHÁC
  status            String             @default("NEW") // NEW, QUALIFIED, SCHEDULED, CHECKIN, PURCHASE, JUNK
  telesale          String?            // Tên Telesale phụ trách (XUÂN, NHI, QUYÊN...)
  branch            String?            // Chi nhánh (THỦ ĐỨC, BIÊN HÒA, GÒ VẤP...)
  branchGroup       String?            // Nhóm khu vực (HCM, ĐỒNG NAI, BÌNH DƯƠNG...)
  service           String?            // Dịch vụ (CN, IMP, SỨ, TRÁM, CVR...)
  serviceGroup      String?            // Nhóm DV (CHỈNH NHA, IMPLANT, RĂNG SỨ, TỔNG QUÁT)
  checkinDate       String?            // YYYY-MM-DD ngày check-in từ Cột H
  isMonthNote       Boolean            @default(false) // "TRONG THÁNG X" trong Cột H
  result            String?            // Đậu, Rớt, Chưa có
  isOldCustomer     Boolean            @default(false) // Cột O: OLD/CU/KHACH CU
  isKoMkt           Boolean            @default(false) // Cột K = 0 (Không MKT)
  isVietKieu        Boolean            @default(false) // Cột N: VK / Việt Kiều
  isNN              Boolean            @default(false) // Cột N: NN / Nước Ngoài
  revenue           Float              @default(0) // Doanh thu từ Cột J
  actualRevenue     Float              @default(0) // Thực thu từ Cột M
  caTheoRevenue     Float              @default(0) // DT Ca theo từ Cột L
  fbclid            String?
  fbp               String?
  fbc               String?
  note              String?
  value             Float?
  currency          String             @default("VND")
  syncedToMeta      Boolean            @default(false)
  metaEventResponse String?
  ref               String?            // "Form" (Đăng ký form), "App" (Sheet DATHEN), "Checkin" (Sheet Telesale)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  statusHistory     CRMStatusHistory[]

  @@index([phone])
  @@index([status])
  @@index([createdAt])
  @@index([sourceGroup])
  @@index([telesale])
  @@index([branchGroup])
}

model CRMStatusHistory {
  id             String   @id @default(cuid())
  leadId         String
  lead           CRMLead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  previousStatus String
  newStatus      String
  updatedBy      String   @default("SYSTEM") // TELE_SHEET, ADMIN_UI, WEBHOOK
  createdAt      DateTime @default(now())
}


